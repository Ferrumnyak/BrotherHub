# Настройки установщика для друзей.
# scripts\release.ps1 копирует этот файл в release.env — он в git не попадает,
# поэтому адрес сервера не окажется в публичном репозитории.

# Адрес сервера друзей: wss://домен (или ws://IP:8080, если без шифрования).
SERVER=wss://example.com

# Ключ подписи обновлений (создаёт scripts\updater-key.ps1). Обычно не нужно:
# по умолчанию берётся %USERPROFILE%\.tauri\brotherhub.key, а пароль
# спрашивается при сборке. Можно вписать, чтобы не вводить каждый раз:
# UPDATER_KEY=C:\путь\к\brotherhub.key
# UPDATER_KEY_PASSWORD=пароль
