# Настройки BrotherWatch на сервере.
# Скопируй в .env (cp .env.example .env) и заполни. Файл .env — только на
# сервере, в git он не попадает: в нём пароль и ключи.

# Домен для приложения. Он же — адрес для установщика: wss://ДОМЕН
DOMAIN=watch.example.com

# Домен для голоса — обычно поддомен первого.
VOICE_DOMAIN=voice.watch.example.com

# Пароль для входа, который ты скажешь друзьям.
BROTHERWATCH_PASSWORD=

# Ключи голосового сервера. Ключ — любое слово, секрет — длинная случайная
# строка. Сгенерировать секрет:  openssl rand -hex 32
LIVEKIT_API_KEY=brotherwatch
LIVEKIT_API_SECRET=
