{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrotherWatch",
  "version": "0.1.0",
  "identifier": "com.ferrumnyak.brotherwatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BrotherWatch",
        "width": 1000,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Ferrumnyak",
    "shortDescription": "Совместный просмотр фильмов и сериалов с друзьями",
    "longDescription": "BrotherWatch — синхронный просмотр видео с друзьями, голосовая связь и текстовый чат.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
