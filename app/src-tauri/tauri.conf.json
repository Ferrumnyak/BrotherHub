{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrotherHub",
  "version": "0.3.0",
  "identifier": "com.ferrumnyak.brotherwatch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BrotherHub",
        "width": 1180,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "backgroundColor": "#191416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Ferrumnyak",
    "shortDescription": "Совместный просмотр фильмов и сериалов с друзьями",
    "longDescription": "BrotherHub — синхронный просмотр видео с друзьями, голосовая связь и текстовый чат.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Ferrumnyak/Brotherwatch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
